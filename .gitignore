# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local npm workaround: pins script-shell to this machine's Git Bash because the
# "&" in the parent folder name breaks npm's Windows .cmd shims. It is a
# Windows-only absolute path and would break installs/builds on Linux, macOS
# and CI (Vercel), so it stays out of the repo.
.npmrc
